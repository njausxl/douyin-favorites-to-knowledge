+def _segment_settings() -> tuple[int, int]:
+    """Return ``(segment_seconds, threshold_seconds)`` for long-media splitting."""
+    try:
+        segment = int((os.environ.get("DOUYIN_ASR_SEGMENT_SECONDS") or "").strip() or DEFAULT_SEGMENT_SECONDS)
+    except ValueError:
+        segment = DEFAULT_SEGMENT_SECONDS
+    try:
+        threshold = int(
+            (os.environ.get("DOUYIN_ASR_SEGMENT_THRESHOLD_SECONDS") or "").strip()
+            or DEFAULT_SEGMENT_THRESHOLD_SECONDS
+        )
+    except ValueError:
+        threshold = DEFAULT_SEGMENT_THRESHOLD_SECONDS
+    return max(60, segment), max(60, threshold)
+
+
+def _stream_audio_segments(url: str, root: Path, segment_seconds: int, duration: float) -> list[Path]:
+    """Stream ``url`` through ffmpeg, keep audio only, split into ordered mp3 parts.
+
+    The video stream never reaches the disk — that is what makes an 8 h item
+    feasible, since its audio is ~250 MB while its video stream is several GB.
+    ``-reconnect`` keeps a long pull alive across transient CDN hiccups.
+    """
+    exe = _ffmpeg_exe()
+    if not exe:
+        return []
+    rate, bitrate = _audio_encode_settings()
+    headers = (
+        "Referer: https://www.douyin.com/\r\n"
+        f"User-Agent: {FFMPEG_UA}\r\n"
+    )
+    pattern = root / "part-%03d.mp3"
+    timeout = int(max(1800, duration * 2))
+    try:
+        completed = subprocess.run(
+            [
+                exe,
+                "-nostdin",
+                "-y",
+                "-hide_banner",
+                "-loglevel",
+                "error",
+                "-headers",
+                headers,
+                "-reconnect",
+                "1",
+                "-reconnect_streamed",
+                "1",
+                "-reconnect_delay_max",
+                "10",
+                "-i",
+                url,
+                "-vn",
+                "-ac",
+                "1",
+                "-ar",
+                rate,
+                "-b:a",
+                bitrate,
+                "-f",
+                "segment",
+                "-segment_time",
+                str(segment_seconds),
+                "-reset_timestamps",
+                "1",
+                str(pattern),
+            ],
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            check=False,
+        )
+    except (OSError, subprocess.TimeoutExpired, TimeoutError):
+        return []
+    parts = sorted(p for p in root.glob("part-*.mp3") if p.stat().st_size > 0)
+    # A non-zero exit may still leave usable parts (e.g. the pull died near the
+    # end); only give up when nothing at all was produced.
+    if not parts and completed.returncode != 0:
+        return []
+    return parts
+
+
+def _transcribe_parts(parts: list[Path], api_key: str, model: str, endpoint: str) -> tuple[str, int]:
+    """Upload each part in order; return ``(joined_text, parts_ok)``."""
+    blocks: list[str] = []
+    ok = 0
+    for part in parts:
+        try:
+            text = _upload_transcribe(part, api_key, model, endpoint)
+        except (OSError, TimeoutError, urllib.error.HTTPError, urllib.error.URLError):
+            text = ""
+        if text:
+            ok += 1
+            blocks.append(text)
+    return "\n\n".join(blocks).strip(), ok
+
