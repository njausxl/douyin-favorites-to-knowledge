+def _ffmpeg_exe() -> str | None:
+    """Locate an ffmpeg binary, or None.
+
+    Order: explicit ``DOUYIN_ASR_FFMPEG`` -> ``PATH`` -> the static build bundled
+    with ``imageio-ffmpeg``. That last fallback matters: on the machine this
+    pipeline was validated on ffmpeg is *not* on ``PATH``, so ``_extract_audio``
+    used to bail out and upload the raw video file instead of compact audio.
+    The bundled build is a full one (libmp3lame, http/https, ``-reconnect``).
+    """
+    explicit = (os.environ.get("DOUYIN_ASR_FFMPEG") or "").strip()
+    if explicit and Path(explicit).exists():
+        return explicit
+    found = shutil.which("ffmpeg")
+    if found:
+        return found
+    try:
+        import imageio_ffmpeg  # type: ignore
+
+        bundled = imageio_ffmpeg.get_ffmpeg_exe()
+    except Exception:  # noqa: BLE001
+        return None
+    return bundled if bundled and Path(bundled).exists() else None
+
