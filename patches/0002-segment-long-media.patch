+# --- Long-media segmentation ----------------------------------------------
+# Very long items fail for two different reasons, and one fix covers both:
+#   * a 2.5 h and a 9.7 h item returned ``failed`` after a *successful* download
+#     (the upload is simply too long for one SenseVoice request), while a 2 h
+#     item succeeded;
+#   * an 8.8 h item never downloaded at all — its video stream (~7 GB) exceeds
+#     any sane ``max_media_bytes``.
+# So for long media we stop downloading the video stream entirely and let
+# ffmpeg pull the signed URL, discard the video and cut the audio into parts:
+#   * an 8 h video costs ~250 MB of temp audio instead of ~7 GB of video;
+#   * each upload stays far inside the ASR length limit.
+# Parts are transcribed independently and concatenated in order.
+DEFAULT_SEGMENT_SECONDS = 1800            # 30 min of audio per part
+DEFAULT_SEGMENT_THRESHOLD_SECONDS = 3600  # only segment beyond 1 h
+FFMPEG_UA = (
+    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
+    "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
+)
+
